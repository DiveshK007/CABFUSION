rules_version = '2';
// CabFusion Cloud Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Profiles: anyone signed in can read (names on shared rides), only the owner writes.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Ride requests: open requests must be readable by other riders for matching.
    match /rideRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.riderId == request.auth.uid
                    && request.resource.data.status == 'SEARCHING';
      // Owner may change anything; other riders/drivers may only link it to a group or move its status.
      allow update: if signedIn() && (resource.data.riderId == request.auth.uid
                    || onlyChanges(['status', 'groupId', 'fareShare', 'matchScore']));
      allow delete: if false;
    }

    // Ride groups: created by one of the riders in it; a driver may claim a FORMED group;
    // afterwards only that driver or the group's riders can update it.
    match /rideGroups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.riderIds
                    && request.resource.data.status == 'FORMED';
      allow update: if signedIn() && (
             (resource.data.status == 'FORMED' && request.resource.data.driverId == request.auth.uid)
          || resource.data.driverId == request.auth.uid
          || request.auth.uid in resource.data.riderIds);
      allow delete: if false;
    }
  }
}
