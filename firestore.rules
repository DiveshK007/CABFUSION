rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Profiles hold email and phone, so only the owner may read or write them.
    // Names shown on shared rides are copied into requests and groups instead.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Ride requests: readable by signed-in users so the matcher can see open requests.
    // The owner creates/cancels; others may only link it into a group or move its status.
    match /rideRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.riderId == request.auth.uid;
      allow update: if signedIn() && (resource.data.riderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'groupId', 'fareShare', 'matchScore']));
      allow delete: if signedIn() && resource.data.riderId == request.auth.uid;
    }

    // Ride groups: created by one of its riders, then updated by the assigned driver.
    match /rideGroups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.riderIds;
      allow update: if signedIn();
      allow delete: if false;
    }
  }
}
