<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CabFusion" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/primary_emerald</item>
        <item name="android:navigationBarColor">@color/dark_card</item>
        <item name="colorPrimary">@color/accent_teal_bright</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSurface">@color/dark_card</item>
    </style>

    <style name="CF.Title" parent="">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CF.Label" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="CF.Body" parent="">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="CF.Input" parent="">
        <item name="android:background">@drawable/bg_dark_input</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="CF.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="CF.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="strokeColor">@color/dark_border</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="CF.Card" parent="">
        <item name="android:background">@drawable/bg_dark_card</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
