<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
    android:background="@drawable/bg_dark_card" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/tvRoute" style="@style/CF.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
        <TextView android:id="@+id/tvFare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical">
        <TextView android:id="@+id/tvMeta" style="@style/CF.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip"
            android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:textColor="@color/text_soft" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
