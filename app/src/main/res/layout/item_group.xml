<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
    android:background="@drawable/bg_dark_card" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/tvRiders" style="@style/CF.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textStyle="bold"/>
        <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/accent_teal_bright" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/tvStops" style="@style/CF.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp"/>
    <TextView android:id="@+id/tvMeta" style="@style/CF.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnAccept" style="@style/CF.Button" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Accept ride"/>
</LinearLayout>
