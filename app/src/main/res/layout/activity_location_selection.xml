<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/dark_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/primary_emerald"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp"
                android:src="@drawable/ic_back" android:contentDescription="Back"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Plan your ride" android:textColor="@color/text_white" android:textSize="18sp" android:textStyle="bold"/>
            <ImageView android:id="@+id/btnMyLocation" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp"
                android:src="@drawable/ic_my_location" app:tint="@color/text_soft" android:contentDescription="Use my location"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <AutoCompleteTextView android:id="@+id/etPickup" style="@style/CF.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:completionThreshold="2" android:hint="Pickup location" android:imeOptions="actionNext" android:inputType="text" android:dropDownHeight="wrap_content"/>
                <AutoCompleteTextView android:id="@+id/etDrop" style="@style/CF.Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:completionThreshold="2" android:hint="Where to?" android:imeOptions="actionDone" android:inputType="text"/>
            </LinearLayout>
            <FrameLayout android:id="@+id/btnSwap" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="10dp"
                android:background="@drawable/bg_swap_button">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_swap" android:contentDescription="Swap"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <org.osmdroid.views.MapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:id="@+id/tvMapHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp" android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Long-press the map to set the drop point"
            android:textColor="@color/text_white" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
            android:padding="4dp" android:text="© OpenStreetMap contributors" android:textColor="#555555" android:textSize="10sp"/>
    </FrameLayout>

    <LinearLayout android:id="@+id/panelTrip" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/dark_card" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/CF.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Distance"/>
                <TextView android:id="@+id/tvDistance" style="@style/CF.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/CF.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time"/>
                <TextView android:id="@+id/tvDuration" style="@style/CF.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/CF.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Solo fare"/>
                <TextView android:id="@+id/tvFare" style="@style/CF.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tvRouteSource" style="@style/CF.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Choose pickup and drop to see the route"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnShared" style="@style/CF.Button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:enabled="false" android:text="Find shared ride"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSolo" style="@style/CF.Button.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp" android:enabled="false" android:text="Ride solo"/>
    </LinearLayout>
</LinearLayout>
